# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/classroom_companion

# LLM Provider — swap between 'anthropic' | 'openai' | 'gemini'
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# App
APP_ENV=development
LOG_LEVEL=INFO
